# -----------------------------------------------------------------------------
# Chapter One - Local Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# -----------------------------------------------------------------------------

# Application Environment
NODE_ENV=development

# Fastify API Configuration
API_PORT=3001
API_HOST=0.0.0.0

# PostgreSQL Configuration (Docker Compose)
POSTGRES_DB=chapter_one_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chapter_one_dev
