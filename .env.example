# -----------------------------------------------------------------------------
# Chapter One - Local Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# -----------------------------------------------------------------------------

# Application Environment
NODE_ENV=development

# Fastify API Configuration
API_PORT=3001
API_HOST=0.0.0.0

# PostgreSQL Configuration (Docker Compose)
POSTGRES_DB=chapter_one_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chapter_one_dev

# Backend Authentication Configuration (Clerk / OIDC JWKS)
# Para desarrollo local y pruebas se puede activar AUTH_MOCK=true
AUTH_JWKS_URI=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
AUTH_ISSUER=https://your-clerk-instance.clerk.accounts.dev
AUTH_AUDIENCE=
AUTH_MOCK=true

# Mobile Client Configuration (Expo / apps/mobile)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_TU_CLERK_PUBLISHABLE_KEY_AQUI
EXPO_PUBLIC_API_URL=https://chapter-api.odysseo.uk
