# -----------------------------------------------------------------------------
# Chapter One - Configuración de Entorno de Producción (Servidor J1900 / Docker)
# Copiar este archivo a .env en el servidor: cp .env.production.example .env
# -----------------------------------------------------------------------------

# Entorno de la aplicación
NODE_ENV=production

# Configuración de la API Fastify
API_PORT=3001
API_HOST=0.0.0.0

# Configuración de PostgreSQL (Red interna de Docker)
POSTGRES_DB=chapter_one_prod
POSTGRES_USER=chapter_one
POSTGRES_PASSWORD=DEFINIR_PASSWORD_SEGURO_AQUI

# Configuración de Autenticación (Clerk / OIDC JWKS)
# Reemplazar con las URLs de tu instancia de Clerk de producción
AUTH_JWKS_URI=https://your-production-clerk.clerk.accounts.dev/.well-known/jwks.json
AUTH_ISSUER=https://your-production-clerk.clerk.accounts.dev
AUTH_AUDIENCE=
AUTH_MOCK=false

# Parámetros adicionales del pool de conexiones (opcional)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
