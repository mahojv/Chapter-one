{
  "name": "chapter-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm run dev --workspace=@chapter-one/api",
    "dev:mobile": "npm run start --workspace=mobile",
    "db:migrate": "npm run db:migrate --workspace=@chapter-one/api",
    "db:seed": "npm run db:seed --workspace=@chapter-one/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}